# Required in all envs
# For SQLite (dev): file:./dev.db
# For PostgreSQL (prod): postgresql://USER:PASS@HOST:5432/dbname
DATABASE_URL="file:./dev.db"

# Required in production. Generate with: openssl rand -hex 32
AUTH_SECRET="dev-secret-change-me-in-production"

# Public base URL of the site (used for Stripe redirects and email links)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Stripe (optional in dev; required for real payments in prod)
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."

# Resend (optional in dev; required to actually send emails in prod)
# RESEND_API_KEY="re_..."

# Cron secret: required to call /api/cron/* endpoints
# CRON_SECRET="long-random-string"
