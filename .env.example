# ─── Base de données ──────────────────────────────────────────────────────────
# PostgreSQL (Neon serverless recommandé — gratuit sur neon.tech)
DATABASE_URL="postgresql://user:pass@host.neon.tech/dbname?sslmode=require"

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Clé JWT — générer avec : openssl rand -hex 32
AUTH_SECRET="change-me-in-production"

# ─── Site ─────────────────────────────────────────────────────────────────────
# URL publique du site (utilisée pour les redirects Stripe et les liens email)
NEXT_PUBLIC_SITE_URL="https://votre-domaine.vercel.app"

# ─── Stripe ───────────────────────────────────────────────────────────────────
# Clés disponibles sur dashboard.stripe.com > Développeurs > Clés API
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_PUBLISHABLE_KEY="pk_live_..."

# Secret du webhook Stripe (dashboard.stripe.com > Développeurs > Webhooks)
# Endpoint : https://votre-domaine.vercel.app/api/stripe/webhook
# Événements requis : checkout.session.completed, invoice.payment_failed, customer.subscription.deleted
STRIPE_WEBHOOK_SECRET="whsec_..."

# ─── Emails (Resend) ──────────────────────────────────────────────────────────
# Clé API sur resend.com — gratuit jusqu'à 3000 emails/mois
# Vérifier votre domaine dans Resend avant d'envoyer en production
RESEND_API_KEY="re_..."

# ─── Cron ────────────────────────────────────────────────────────────────────
# Vercel l'injecte automatiquement dans Authorization: Bearer <secret> sur les crons
# Générer avec : openssl rand -hex 32
CRON_SECRET="change-me-in-production"
