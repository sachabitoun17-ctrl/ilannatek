generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// SQLite does not support native enums. Validation lives in src/lib/enums.ts (Zod).

// ── Multi-tenant org layer ────────────────────────────────────────────────
// Account = a paying customer of the platform (one brand / company).
// Studio  = a bookable location belonging to an account, addressed by slug.
// Phase 1: org structure + superadmin oversight.
// Phase 2 (current): Session/Location/ClassType/Plan/PromoCode/RecurringRule/Settings scoped by studioId.
model Account {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  // SaaS plan tier the client pays us for
  plan         String   @default("STARTER") // STARTER | PRO | SCALE
  status       String   @default("ACTIVE")  // ACTIVE | TRIAL | SUSPENDED
  contactEmail String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  studios      Studio[]
}

model Studio {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name      String
  // URL slug, e.g. /studio/ilannatek-marais
  slug      String   @unique
  city      String?
  timezone  String   @default("Europe/Paris")
  status    String   @default("ACTIVE") // ACTIVE | PAUSED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members        User[]          @relation("StudioMembers")
  sessions       Session[]       @relation("StudioSessions")
  locations      Location[]      @relation("StudioLocations")
  classTypes     ClassType[]     @relation("StudioClassTypes")
  recurringRules RecurringRule[] @relation("StudioRecurringRules")
  plans          Plan[]          @relation("StudioPlans")
  promoCodes     PromoCode[]     @relation("StudioPromoCodes")
  settings       Settings[]      @relation("StudioSettings")

  @@index([accountId])
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  passwordHash    String
  firstName       String
  lastName        String
  phone           String?
  role            String   @default("USER")
  // Tenant scoping: the studio this member belongs to. Members only ever see
  // their own studio. Null for SUPERADMIN (platform-level, studio-agnostic).
  studioId        String?
  studio          Studio?  @relation("StudioMembers", fields: [studioId], references: [id])
  creditsBalance  Int      @default(0)
  instructorBio   String?
  instructorPhoto String?
  emailVerifiedAt DateTime?
  // session version: bump to invalidate all existing JWTs for this user
  sessionVersion  Int      @default(0)
  // Stripe references
  stripeCustomerId String? @unique
  // status flags
  active          Boolean  @default(true)
  // soft-blocked because of repeated no-shows
  banned          Boolean  @default(false)
  // freeze credits until this date (self-service holiday pause)
  creditsFrozenUntil DateTime?
  // opt-in: show first name on session attendee list to other members
  attendeeVisible Boolean  @default(false)
  // RGPD: opt-out of marketing/lifecycle emails (transactional emails still sent)
  emailOptIn      Boolean  @default(true)
  // dedupe marker for the low-credits nudge cron
  lowCreditsNotifiedAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  bookings           Booking[]
  transactions       Transaction[]
  subscriptions      Subscription[]
  sessions           Session[]      @relation("InstructorSessions")
  checkIns           CheckIn[]
  auditLogs          AuditLog[]     @relation("AuditActor")
  loginAttempts      LoginAttempt[]
  passwordResetTokens PasswordResetToken[]
  loginOtps          LoginOtp[]
  sentInvites        FriendInvite[] @relation("SentInvites")
  subRequestsMade    SubRequest[]   @relation("SubRequests")
  subAssignments     SubRequest[]   @relation("SubAssigned")
}

model LoginAttempt {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String
  ip        String?
  success   Boolean
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
}

model Location {
  id        String   @id @default(cuid())
  studioId  String?
  studio    Studio?  @relation("StudioLocations", fields: [studioId], references: [id])
  name      String
  address   String?
  timezone  String   @default("Europe/Paris")
  createdAt DateTime @default(now())

  sessions Session[]

  @@index([studioId])
}

model ClassType {
  id          String   @id @default(cuid())
  studioId    String?
  studio      Studio?  @relation("StudioClassTypes", fields: [studioId], references: [id])
  name        String
  description String?
  durationMin Int      @default(60)
  creditCost  Int      @default(1)
  color       String   @default("#ec4899")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  sessions       Session[]
  recurringRules RecurringRule[]

  @@index([studioId])
}

model RecurringRule {
  id           String   @id @default(cuid())
  studioId     String?
  studio       Studio?  @relation("StudioRecurringRules", fields: [studioId], references: [id])
  classTypeId  String
  classType    ClassType @relation(fields: [classTypeId], references: [id])
  instructorId String
  locationId   String
  // bitmask 0=Sunday..6=Saturday or comma-separated days; we keep simple csv
  daysOfWeek   String
  startTimeMin Int       // minutes from midnight
  capacity     Int       @default(15)
  startDate    DateTime
  endDate      DateTime
  createdAt    DateTime  @default(now())

  @@index([studioId])
}

model Session {
  id           String    @id @default(cuid())
  studioId     String?
  studio       Studio?   @relation("StudioSessions", fields: [studioId], references: [id])
  classTypeId  String
  classType    ClassType @relation(fields: [classTypeId], references: [id])
  instructorId String
  instructor   User      @relation("InstructorSessions", fields: [instructorId], references: [id])
  locationId   String
  location     Location  @relation(fields: [locationId], references: [id])
  startTime    DateTime
  endTime      DateTime
  capacity     Int       @default(15)
  // override cancellation cutoff (minutes) for this session, fallback to studio settings
  cancellationCutoffMin Int?
  status       String    @default("SCHEDULED")
  notes        String?
  recurringRuleId String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  bookings   Booking[]
  checkIns   CheckIn[]
  subRequest SubRequest?

  @@index([startTime])
  @@index([studioId, startTime])
  @@index([instructorId, startTime])
  @@index([locationId, startTime])
}

model Booking {
  id              String   @id @default(cuid())
  sessionId       String
  session         Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  status          String   @default("CONFIRMED")
  waitlistPos     Int?
  creditsUsed     Int      @default(0)
  // late cancel / no show fee in credits
  feeApplied      Int      @default(0)
  cancelledAt     DateTime?
  promotedFromWaitlistAt DateTime?
  reminder2hSentAt DateTime?
  reminderSentAt  DateTime?
  postClassSentAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  waitlistTokens WaitlistToken[]

  @@unique([sessionId, userId])
  @@index([userId])
  @@index([status])
  @@index([sessionId, status])
}

model CheckIn {
  id        String   @id @default(cuid())
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  source    String   // QR | MANUAL | SELF
  createdAt DateTime @default(now())

  @@unique([sessionId, userId])
}

model Plan {
  id              String   @id @default(cuid())
  studioId        String?
  studio          Studio?  @relation("StudioPlans", fields: [studioId], references: [id])
  name            String
  description     String?
  type            String   // CREDIT_PACK | SUBSCRIPTION
  priceCents      Int
  creditsAmount   Int?
  intervalDays    Int?
  creditsPerCycle Int?
  active          Boolean  @default(true)
  // optional Stripe price id, set once and used by checkout
  stripePriceId   String?  @unique
  // only sellable to brand new accounts (first-time intro offer)
  introOnly       Boolean  @default(false)
  // max number of these a single user can buy
  maxPerUser      Int?
  createdAt       DateTime @default(now())

  subscriptions Subscription[]
  transactions  Transaction[]

  @@index([studioId])
}

model Subscription {
  id                  String   @id @default(cuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id])
  planId              String
  plan                Plan     @relation(fields: [planId], references: [id])
  status              String   @default("ACTIVE") // ACTIVE | CANCELLED | EXPIRED | FROZEN
  startDate           DateTime @default(now())
  endDate             DateTime
  autoRenew           Boolean  @default(true)
  // frozen subscriptions don't expire; track how much was paused
  frozenAt            DateTime?
  resumedAt           DateTime?
  stripeSubscriptionId String? @unique
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([userId, status])
  @@index([endDate])
}

model PromoCode {
  id           String   @id @default(cuid())
  studioId     String?
  studio       Studio?  @relation("StudioPromoCodes", fields: [studioId], references: [id])
  code         String   @unique
  description  String?
  // discount type: PERCENT or FIXED_CENTS or FREE_CREDITS
  discountType String
  discountValue Int
  maxUses      Int?
  uses         Int       @default(0)
  expiresAt    DateTime?
  // restrict to certain plans (comma-separated ids) or null = any
  applicablePlanIds String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  redemptions PromoRedemption[]

  @@index([studioId])
}

model PromoRedemption {
  id        String   @id @default(cuid())
  codeId    String
  code      PromoCode @relation(fields: [codeId], references: [id])
  userId    String
  transactionId String?
  appliedAmount Int    @default(0)
  createdAt DateTime  @default(now())

  @@unique([codeId, userId])
}

model Transaction {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  planId       String?
  plan         Plan?    @relation(fields: [planId], references: [id])
  type         String
  amountCents  Int      @default(0)
  creditsDelta Int      @default(0)
  description  String?
  // payment status: PENDING | PAID | REFUNDED | FAILED | FREE
  paymentStatus String  @default("FREE")
  // Stripe checkout/session/payment intent reference (idempotency key)
  stripeRef    String?  @unique
  // idempotency key for client-driven actions
  idempotencyKey String? @unique
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@index([type, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation("AuditActor", fields: [actorId], references: [id])
  action    String   // CREATE_SESSION, ADJUST_CREDITS, SET_ROLE, CANCEL_BOOKING, ...
  entity    String?
  entityId  String?
  metadata  String?  // JSON
  ip        String?
  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([token])
}

// Token sent when a waitlist spot opens — member has 30 min to confirm
model WaitlistToken {
  id        String   @id @default(cuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  // set once the cleanup cron has processed this expired token (offer passed on)
  cascadedAt DateTime?
  createdAt DateTime @default(now())

  @@index([token])
  @@index([bookingId])
  @@index([expiresAt, usedAt, cascadedAt])
}

// One-time login code (email 2FA) — required for ADMIN sign-in
model LoginOtp {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// Failed transactional emails persisted for retry by the email-retry cron
model EmailOutbox {
  id          String   @id @default(cuid())
  to          String
  subject     String
  html        String
  text        String?
  // PENDING | SENT | FAILED
  status      String   @default("PENDING")
  attempts    Int      @default(0)
  lastError   String?
  nextRetryAt DateTime @default(now())
  sentAt      DateTime?
  createdAt   DateTime @default(now())

  @@index([status, nextRetryAt])
}

// Duo invite — member sends 1 free credit to a friend
model FriendInvite {
  id             String   @id @default(cuid())
  fromUserId     String
  from           User     @relation("SentInvites", fields: [fromUserId], references: [id])
  toEmail        String
  token          String   @unique
  creditsGranted Int      @default(1)
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime @default(now())

  @@index([fromUserId])
  @@index([token])
}

// Instructor substitution request — one per session max
model SubRequest {
  id          String   @id @default(cuid())
  sessionId   String   @unique
  session     Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  requesterId String
  requester   User     @relation("SubRequests", fields: [requesterId], references: [id])
  reason      String?
  // OPEN | ASSIGNED | CANCELLED
  status      String   @default("OPEN")
  subId       String?
  sub         User?    @relation("SubAssigned", fields: [subId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, createdAt])
  @@index([requesterId])
}

model Settings {
  id                    String   @id @default("singleton")
  studioId              String?  @unique
  studio                Studio?  @relation("StudioSettings", fields: [studioId], references: [id])
  studioName            String   @default("Ilannatek")
  // cancellation cutoff in minutes (members can't cancel within this window)
  cancellationCutoffMin Int      @default(120)
  // late-cancel fee in credits (deducted if member cancels after cutoff)
  lateCancelFee         Int      @default(1)
  // no-show fee (admin can mark NO_SHOW and apply this)
  noShowFee             Int      @default(2)
  // bookings open this many days in advance
  bookingWindowDays     Int      @default(14)
  // welcome credits granted on signup
  welcomeCredits        Int      @default(0)
  // email sender
  emailFrom             String   @default("noreply@ilannatek.fr")
  // Stripe public key (also exposed at runtime to client)
  stripePublishableKey  String?
  updatedAt             DateTime @updatedAt @default(now())
}
