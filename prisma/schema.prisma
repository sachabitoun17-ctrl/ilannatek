generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite does not support native enums.
// Values: role USER|INSTRUCTOR|ADMIN, session SCHEDULED|CANCELLED|COMPLETED,
// booking CONFIRMED|WAITLIST|CANCELLED|ATTENDED|NO_SHOW,
// plan CREDIT_PACK|SUBSCRIPTION, sub ACTIVE|CANCELLED|EXPIRED,
// tx PURCHASE_PACK|PURCHASE_SUBSCRIPTION|CREDIT_USE|CREDIT_REFUND|ADMIN_ADJUST

model User {
  id              String         @id @default(cuid())
  email           String         @unique
  passwordHash    String
  firstName       String
  lastName        String
  phone           String?
  role            String         @default("USER")
  creditsBalance  Int            @default(0)
  instructorBio   String?
  instructorPhoto String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  bookings      Booking[]
  transactions  Transaction[]
  subscriptions Subscription[]
  sessions      Session[]      @relation("InstructorSessions")
}

model Location {
  id        String   @id @default(cuid())
  name      String
  address   String?
  createdAt DateTime @default(now())

  sessions  Session[]
}

model ClassType {
  id          String   @id @default(cuid())
  name        String
  description String?
  durationMin Int      @default(60)
  creditCost  Int      @default(1)
  color       String   @default("#ec4899")
  createdAt   DateTime @default(now())

  sessions    Session[]
}

model Session {
  id           String   @id @default(cuid())
  classTypeId  String
  classType    ClassType @relation(fields: [classTypeId], references: [id])
  instructorId String
  instructor   User     @relation("InstructorSessions", fields: [instructorId], references: [id])
  locationId   String
  location     Location @relation(fields: [locationId], references: [id])
  startTime    DateTime
  endTime      DateTime
  capacity     Int      @default(15)
  status       String   @default("SCHEDULED")
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  bookings     Booking[]

  @@index([startTime])
  @@index([instructorId])
}

model Booking {
  id          String   @id @default(cuid())
  sessionId   String
  session     Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  status      String   @default("CONFIRMED")
  waitlistPos Int?
  creditsUsed Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([sessionId, userId])
  @@index([userId])
  @@index([status])
  @@index([sessionId, status])
}

model Plan {
  id              String   @id @default(cuid())
  name            String
  description     String?
  type            String
  priceCents      Int
  creditsAmount   Int?
  intervalDays    Int?
  creditsPerCycle Int?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())

  subscriptions Subscription[]
  transactions  Transaction[]
}

model Subscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  planId    String
  plan      Plan     @relation(fields: [planId], references: [id])
  status    String   @default("ACTIVE")
  startDate DateTime @default(now())
  endDate   DateTime
  autoRenew Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
}

model Transaction {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  planId       String?
  plan         Plan?    @relation(fields: [planId], references: [id])
  type         String
  amountCents  Int      @default(0)
  creditsDelta Int      @default(0)
  description  String?
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
}
